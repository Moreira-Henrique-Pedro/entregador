ENVIRONMENT=development
LOG_LEVEL=debug
APP_NAME=delivery-api
APP_VERSION=local
HTTP_PORT=8081

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=delivery

# log: só escreve a notificação no log | twilio: envia pelo WhatsApp
NOTIFIER_PROVIDER=log
NOTIFIER_DEFAULT_COUNTRY_CODE=55
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=+11223344556
TWILIO_CONTENT_SID_DELIVERY_ARRIVED=
TWILIO_CONTENT_SID_DELIVERY_PICKED_UP=

# pubsub (padrão, usado no Cloud Run) | kafka (usa cmd/worker)
MESSAGING_PROVIDER=pubsub

# --- Pub/Sub ---
GCP_PROJECT_ID=entregador-local
PUBSUB_NOTIFICATIONS_TOPIC=delivery-notifications
# Local: emulador do docker-compose (make infra). Em produção, NÃO defina.
PUBSUB_EMULATOR_HOST=localhost:8085
# Local: o emulador não assina o push. Em produção, deixe true e defina os dois abaixo.
PUBSUB_PUSH_VERIFY_TOKEN=false
PUBSUB_PUSH_AUDIENCE=
PUBSUB_PUSH_SERVICE_ACCOUNT=

# --- Kafka (só com MESSAGING_PROVIDER=kafka) ---
DELIVERY_BROKER_HOSTS=localhost:9094
INTERNAL_COMMANDS_TOPIC=delivery-internal.commands
DLQ_TOPIC=delivery-subscriber.dlq
